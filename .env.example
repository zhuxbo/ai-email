# Copy to .env (gitignored) and fill in your own values.
# DO NOT commit .env or any file containing real credentials.

# ─── Database ─────────────────────────────────────────────
# Local dev: matches docker-compose.yml defaults (OrbStack).
# Prod: point at your managed PG (must support TLS).
DATABASE_URL=postgresql://aiemail:aiemail_dev@localhost:5432/ai_email_dev

# Optionally override what docker compose passes to the container.
# POSTGRES_USER=aiemail
# POSTGRES_PASSWORD=aiemail_dev
# POSTGRES_DB=ai_email_dev

# ─── Logging ──────────────────────────────────────────────
# trace | debug | info | warn | error
RUST_LOG=info

# ─── AI provider keys ─────────────────────────────────────
# Sprint 2.5 onward: AI keys are stored in the OS keychain and managed via the
# in-app "AI 设置" panel. Add a model (Anthropic / OpenAI / DeepSeek / 智谱 GLM /
# Moonshot Kimi / 通义) in the UI; the key goes straight to keychain, never to .env
# or to the database. No environment variables read for AI keys at runtime.

# ─── Dev only ─────────────────────────────────────────────
# A QQ Mail address + authorization code (NOT QQ password).
# Generate the auth code at: 邮箱 → 设置 → 账户 → 开启 IMAP/SMTP
# In production the auth code lives only in the OS keychain.
DEV_QQ_EMAIL=
DEV_QQ_AUTH_CODE=
