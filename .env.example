# Copy to .env (gitignored) and fill in your own values.
# DO NOT commit .env or any file containing real credentials.

# ─── Anthropic ────────────────────────────────────────────
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override default base URL (e.g. for proxies)
# ANTHROPIC_API_BASE=https://api.anthropic.com

# ─── Logging ──────────────────────────────────────────────
# trace | debug | info | warn | error
RUST_LOG=info

# ─── Dev only ─────────────────────────────────────────────
# A QQ Mail address + authorization code (NOT QQ password).
# Generate the auth code at: 邮箱 → 设置 → 账户 → 开启 IMAP/SMTP
# These are loaded only in dev; production reads from OS keychain.
DEV_QQ_EMAIL=
DEV_QQ_AUTH_CODE=
